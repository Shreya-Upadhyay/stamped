# Firebase — copy this file to `.env` and fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup.
#
# These keys are shipped inside the app and are not secrets: they identify the
# project, they don't authorise anything. Access is controlled by
# firebase/firestore.rules. `.env` is gitignored all the same.
#
# With any of these missing the app still runs, but sign-up is disabled and it
# says so on screen.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: point the app at the local Firebase emulators instead of the real
# project, so sign-up and saved trips can be tested without touching real data.
# Run `npx firebase-tools emulators:start --project demo-stamped` from the repo
# root first. 10.0.2.2 is how an Android emulator reaches your machine;
# use your computer's LAN IP from a physical phone.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
